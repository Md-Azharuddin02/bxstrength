# BxStrength Environment Configuration Example

# Server Configuration
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Security & Authentication
JWT_SECRET=bxstrength_super_secret_jwt_key_2026

# Database (PostgreSQL / NeonDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bxstrength

# Razorpay Sandbox / Production
RAZORPAY_KEY_ID=rzp_test_example_key
RAZORPAY_KEY_SECRET=rzp_test_example_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_test_example_key

# Cashfree Sandbox / Production
CASHFREE_APP_ID=TEST_APP_ID
CASHFREE_SECRET_KEY=TEST_SECRET_KEY
CASHFREE_ENV=sandbox

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_example
VITE_STRIPE_SECRET_KEY=sk_test_example

# Email Services (Brevo / SMTP)
BREVO_API_KEY=xkeysib-example-key
BREVO_SENDER_EMAIL=support@bxstrength.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=support@bxstrength.com
SMTP_PASS=smtp_password
VITE_ADMIN_EMAIL=admin@bxstrength.com
VITE_SENDER_EMAIL=support@bxstrength.com
