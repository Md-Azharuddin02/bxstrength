# Frontend build config — PRODUCTION (Vercel).
# PUBLIC values only. Selected by `vite build` (mode=production) — i.e. `npm run build`.
#
# VITE_API_URL is intentionally EMPTY: the app calls relative /api/* paths, and vercel.json
# proxies them to the production Render backend. This keeps the API same-origin so auth cookies
# work (first-party) — do NOT set an absolute onrender.com URL here or it bypasses the proxy.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=171654929533-cdbccjk0peqhhpsqjckhhio2l1l4485n.apps.googleusercontent.com
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
