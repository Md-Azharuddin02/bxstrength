# Frontend build config — STAGING (Vercel).
# PUBLIC values only. Selected by `vite build --mode staging` — i.e. `npm run build:staging`.
#
# VITE_API_URL is intentionally EMPTY: the app calls relative /api/* paths, and the staging
# branch's vercel.json proxies them to the staging Render backend (bxstrength-stg.onrender.com).
# Same-origin -> auth cookies work. Do NOT set an absolute onrender.com URL here.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=171654929533-cdbccjk0peqhhpsqjckhhio2l1l4485n.apps.googleusercontent.com
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
