# BxStrength backend environment (variable names only — never commit real values).
# Copy to Backend/.env (or Backend/.env.development) and fill in.
#
# IMPORTANT: a VITE_* variable is shipped to the browser. Never give a secret a
# VITE_ prefix. Secrets (API keys, client secrets) must use a plain name and stay
# on the server only.

# --- Core (required) ---
NODE_ENV=development
PORT=3001
# Two DIFFERENT long random strings. Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# PostgreSQL connection string
DATABASE_URL=
# Redis for session/token revocation. In dev defaults to redis://127.0.0.1:6379
REDIS_URL=

# --- URLs / CORS ---
# Public site URL, used in email links
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with cookies (set on live server)
CORS_ORIGINS=

# --- Google sign-in ---
# PUBLIC Client ID only (no secret needed for sign-in verification).
# Defaults in code to the project's dev client, so this is optional locally.
GOOGLE_CLIENT_ID=

# --- Email (Brevo / SMTP) ---
ADMIN_EMAIL=support@bxstrength.com
SENDER_EMAIL=support@bxstrength.com
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Payments (server-side secrets) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=
STRIPE_SECRET_KEY=
