# ============================================================================
# Backend environment template.  Copy to one of:
#   Backend/.env.development   (local dev)
#   Backend/.env.staging       (staging  — prod credentials, staging URLs)
#   Backend/.env.production    (production)
# These real files hold SECRETS and are gitignored. On Render, set these as
# dashboard env vars instead of committing a file.
#
# The file is chosen by NODE_ENV (loaded as Backend/.env.<NODE_ENV>):
#   npm run server          -> development
#   npm run server:staging  -> staging
#   npm run server:prod     -> production
# On Render, set NODE_ENV=staging or production in the service's env.
# (NODE_ENV itself is set by the command / dashboard, NOT in this file.)
# ============================================================================

# --- Auth secrets (REQUIRED; JWT_SECRET must differ from JWT_REFRESH_SECRET) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Redis (REQUIRED in staging & production; defaults to localhost in dev) ---
# Render Key Value internal URL, or Upstash rediss:// URL.
REDIS_URL=

# --- Database (Neon/Postgres) ---
# dev: local or a dev branch.  staging: a SEPARATE staging DB is STRONGLY advised
# (sharing the prod DB means test data lands in production).  prod: the prod DB.
DATABASE_URL=

# --- URLs (differ per environment) ---
# APP_URL        = this backend's own public URL (Render service URL).
# CORS_ORIGINS   = comma-separated frontend origins allowed to call the API.
#   dev:     http://localhost:3000
#   staging: https://<your-staging>.vercel.app
#   prod:    https://bxstrength.com,https://www.bxstrength.com
APP_URL=
CORS_ORIGINS=

# Behind Render's proxy. 1 = one proxy hop (Render). Leave unset to default to 1.
TRUST_PROXY_HOPS=1

# Port the server listens on (Render provides PORT automatically).
PORT=3001

# --- Google OAuth (public client id; has a built-in default) ---
# MUST be identical to the frontend's VITE_GOOGLE_CLIENT_ID for the same environment,
# or Google sign-in fails the token-audience check.
GOOGLE_CLIENT_ID=

# --- Cross-site cookies: set when frontend and API share a parent domain ---
# e.g. frontend app.bxstrength.com + API api.bxstrength.com -> COOKIE_DOMAIN=.bxstrength.com
# This makes auth cookies first-party (SameSite=Lax), readable by the frontend, and not blocked
# as third-party. Leave empty for local dev or a single-domain deploy.
COOKIE_DOMAIN=

# --- Payments: Razorpay (test keys in dev/staging, live in prod) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payments: Cashfree ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox   # sandbox in dev/staging, production in prod

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
ADMIN_EMAIL=
