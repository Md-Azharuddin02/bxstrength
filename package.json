{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx server.ts",
    "server:staging": "NODE_ENV=staging tsx server.ts",
    "server:prod": "NODE_ENV=production tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build && mkdir -p ./assets && cp -r dist/assets/* ./assets/ && cp public/.htaccess ./.htaccess",
    "build:staging": "vite build --mode staging && mkdir -p ./assets && cp -r dist/assets/* ./assets/ && cp public/.htaccess ./.htaccess",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "DATABASE_URL= REDIS_URL=redis://127.0.0.1:6379/15 tsx --test Backend/tests/*.test.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.9",
    "pg": "^8.22.0",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "redis": "^6.3.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
